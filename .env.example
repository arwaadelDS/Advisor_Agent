# Copy to .env and fill in. .env is gitignored.

# --- LLM --------------------------------------------------------------------
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# --- Document side ----------------------------------------------------------
# Embeddings run locally via sentence-transformers: no API key, no per-query
# cost, and the corpus never leaves the machine. The model must be multilingual
EMBEDDING_MODEL=BAAI/bge-m3

# Where the built vector index is persisted. Rebuild it with
#   uv run python -m ingestion.build_vector_index
VECTOR_STORE_PATH=data/index

# Optional cross-encoder that re-scores the shortlist before the model sees it.
# Empty means off, which is the default: it reaches 100% recall@5 on the eval
# set but costs ~4s a question on CPU. Needs no index rebuild. Measure it first:
#   uv run python -m ingestion.eval_retrieval --rerank
#   RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL=

# Absolute path to a pdftotext executable. Leave empty to auto-discover.
#
# Set this if `uv run python -m ingestion.doctor` picks the wrong build. On
# Windows, Git for Windows ships an Xpdf pdftotext that usually comes first on
# PATH and silently drops all Arabic; poppler is the one we want. Typical paths:
#   POPPLER_PATH=C:/Users/<you>/AppData/Local/Programs/MiKTeX/miktex/bin/x64/pdftotext.exe
#   POPPLER_PATH=C:/Program Files/poppler/bin/pdftotext.exe
POPPLER_PATH=

# --- SQL side ----------------------------------------------------
SQL_DB_URI=sqlite:///data/mock/advisor.db

# --- Web search agent -------------------------------------------------------
SEARCH_API_KEY=

# Optional: override the model API base URL.
INFERENCE_ENDPOINT=
